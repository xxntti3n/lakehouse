[mysqld]
# Master Configuration
server-id = 1

# Enable GTID for CDC
gtid_mode = ON
enforce_gtid_consistency = ON
log_bin = mysql-bin
binlog_format = ROW
binlog_row_image = FULL

# Allow replicas to connect
# Create replication user in init script or manually

# Log configuration
log_error = /var/log/mysql/error.log
slow_query_log = 1
slow_query_log_file = /var/log/mysql/slow.log
long_query_time = 2
