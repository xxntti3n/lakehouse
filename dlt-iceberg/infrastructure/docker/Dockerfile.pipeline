FROM python:3.11-slim

WORKDIR /app

# Single layer: system deps + Python deps (fewer layers = less Colima/containerd lease errors)
COPY requirements.txt .
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ pkg-config default-libmysqlclient-dev curl \
    && pip install --no-cache-dir -r requirements.txt pymysql cryptography \
    && rm -rf /var/lib/apt/lists/* /root/.cache/pip

# Copy pipeline scripts
COPY run_debezium_dlt.py .
COPY random_data_generator.py .

# Copy debezium_dlt module
COPY debezium_dlt/ /app/debezium_dlt/

# Set environment variables
ENV MYSQL_HOST=mysql
ENV MYSQL_PORT=3306
ENV MYSQL_USER=root
ENV MYSQL_PASSWORD=rootpw
ENV MYSQL_DATABASE=appdb
ENV S3_ENDPOINT_URL=http://minio:9000
ENV S3_ACCESS_KEY=minio
ENV S3_SECRET_KEY=minio123
ENV S3_BUCKET=dlt-warehouse

# Default command (can be overridden by docker-compose)
CMD ["python", "run_debezium_dlt.py"]
