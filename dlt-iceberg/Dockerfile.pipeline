FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    pkg-config \
    default-libmysqlclient-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install additional dependencies for the pipeline
RUN pip install --no-cache-dir pymysql cryptography

# Copy pipeline scripts
COPY run_pipeline.py .
COPY run_pipeline_with_gtid.py .

# Set environment variables
ENV MYSQL_HOST=mysql-source
ENV MYSQL_PORT=3306
ENV MYSQL_USER=root
ENV MYSQL_PASSWORD=rootpw
ENV MYSQL_DATABASE=appdb
ENV S3_ENDPOINT_URL=http://minio:9000
ENV S3_ACCESS_KEY=minio
ENV S3_SECRET_KEY=minio123
ENV S3_BUCKET=dlt-warehouse

CMD ["python", "run_pipeline.py"]
