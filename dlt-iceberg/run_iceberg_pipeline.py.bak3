#!/usr/bin/env python3
"""
DLT Pipeline to Iceberg - Simplified Working Version
"""

import os
import sys
import logging
from datetime import datetime
from typing import Iterator, Dict, Any

import dlt
import pymysql
from pymysqlreplication import BinLogStreamReader
from pymysqlreplication.row_event import (
    DeleteRowsEvent,
    UpdateRowsEvent,
    WriteRowsEvent,
)

# Setup logging
logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s - %(levelname)s - %(message)s'
)
logger = logging.getLogger(__name__)


# =============================================================================
# CONFIGURATION
# =============================================================================

MYSQL_HOST = os.getenv('MYSQL_HOST', 'mysql')
MYSQL_PORT = int(os.getenv('MYSQL_PORT', '3306'))
MYSQL_USER = os.getenv('MYSQL_USER', 'root')
MYSQL_PASSWORD = os.getenv('MYSQL_PASSWORD', 'rootpw')
MYSQL_DATABASE = os.getenv('MYSQL_DATABASE', 'appdb')
S3_ENDPOINT = os.getenv('S3_ENDPOINT_URL', 'http://minio:9000')
S3_ACCESS_KEY = os.getenv('S3_ACCESS_KEY', 'minio')
S3_SECRET_KEY = os.getenv('S3_SECRET_KEY', 'minio123')
WAREHOUSE = 'dlt-warehouse'
NAMESPACE = 'appdb'

# Pipeline settings
SNAPSHOT_MODE = os.getenv('SNAPSHOT_MODE', 'initial')
MAX_EVENTS = int(os.getenv('STREAMING_MAX_EVENTS', '500'))
TABLES = os.getenv('TABLE_INCLUDE_LIST', 'appdb.products,appdb.sales')

# =============================================================================
# CDC SOURCE
# =============================================================================

class MySQLCDCSource:
    def __init__(self):
        self.conn = None

    def get_connection(self):
        if self.conn is None:
            self.conn = pymysql.connect(
                host=MYSQL_HOST,
                port=MYSQL_PORT,
                user=MYSQL_USER,
                password=MYSQL_PASSWORD,
                database=MYSQL_DATABASE,
                cursorclass=pymysql.cursors.DictCursor
            )
        return self.conn

    def snapshot_table(self, table_name):
        logger.info(f"  Snapshotting {table_name}...")
        conn = self.get_connection()
        with conn.cursor() as cursor:
            cursor.execute(f"SELECT * FROM {table_name}")
            columns = [desc[0] for desc in cursor.description]
            count = 0
            for row in cursor:
                record = dict(zip(columns, row))
                record['__op'] = 'r'
                record['__ts_ms'] = int(datetime.now().timestamp() * 1000)
                record['__source'] = 'snapshot'
                for k, v in record.items():
                    if isinstance(v, datetime):
                        record[k] = v.isoformat()
                yield record
                count += 1
        logger.info(f"  Snapshotted {count} rows from {table_name}")

    def stream_table(self, table_name, max_events=None):
        logger.info(f"  Streaming {table_name}...")
        stream = BinLogStreamReader(
            connection_settings={
                'host': MYSQL_HOST,
                'port': MYSQL_PORT,
                'user': MYSQL_USER,
                'passwd': MYSQL_PASSWORD,
            },
            server_id=100,
            only_events=[DeleteRowsEvent, WriteRowsEvent, UpdateRowsEvent],
            blocking=True,
        )
        count = 0
        try:
            for event in stream:
                if event.schema != MYSQL_DATABASE or event.table != table_name:
                    continue
                for row in self._process_event(event):
                    yield row
                    count += 1
                    if count % 50 == 0:
                        logger.info(f"    {count} events...")
                    if max_events and count >= max_events:
                        break
                if max_events and count >= max_events:
                    break
        finally:
            stream.close()
        logger.info(f  Streamed {count} events from {table_name}")

    def _process_event(self, event):
        if isinstance(event, WriteRowsEvent):
            for row in event.rows:
                r = row['values'].copy()
                r['__op'] = 'c'
                r['__ts_ms'] = int(datetime.now().timestamp() * 1000)
                r['__source'] = 'binlog'
                for k, v in r.items():
                    if isinstance(v, datetime):
                        r[k] = v.isoformat()
                yield r
        elif isinstance(event, DeleteRowsEvent):
            for row in event.rows:
                r = row['values'].copy()
                r['__op'] = 'd'
                r['__ts_ms'] = int(datetime.now().timestamp() * 1000)
                r['__source'] = 'binlog'
                for k, v in r.items():
                    if isinstance(v, datetime):
                        r[k] = v.isoformat()
                yield r
        elif isinstance(event, UpdateRowsEvent):
            for row in event.rows:
                r = row['before_values'].copy()
                r['__op'] = 'u_old'
                r['__ts_ms'] = int(datetime.now().timestamp() * 1000)
                r['__source'] = 'binlog'
                for k, v in r.items():
                    if isinstance(v, datetime):
                        r[k] = v.isoformat()
                yield r
                r = row['after_values'].copy()
                r['__op'] = 'u_new'
                r['__ts_ms'] = int(datetime.now().timestamp() * 1000)
                r['__source'] = 'binlog'
                for k, v in r.items():
                    if isinstance(v, datetime):
                        r[k] = v.isoformat()
                yield r


# =============================================================================
# DLT RESOURCE
# =============================================================================

def create_table_resource(table_name, cdc, snapshot=True, max_stream=None):
    
    @dlt.resource(
        name=table_name,
        write_disposition='append',
    )
    def resource():
        if snapshot:
            for r in cdc.snapshot_table(table_name):
                yield r
        for r in cdc.stream_table(table_name, max_stream):
            yield r
    return resource


# =============================================================================
# MAIN
# =============================================================================

def main():
    logger.info("="*60)
    logger.info("DLT CDC TO ICEBERG PIPELINE")
    logger.info("="*60)
    logger.info(f"MySQL: {MYSQL_USER}@{MYSQL_HOST}:{MYSQL_PORT}/{MYSQL_DATABASE}")
    logger.info(f"S3: {S3_ENDPOINT}")
    logger.info(f"Tables: {TABLES}")
    logger.info(f"Snapshot: {SNAPSHOT_MODE}")
    logger.info("="*60)

    cdc = MySQLCDCSource()
    snapshot = SNAPSHOT_MODE == 'initial'
    tables = [t.strip().split('.')[-1] for t in TABLES.split(',')]

    # Configure DLT filesystem destination
    os.environ['DESTINATION__FILESYSTEM__BUCKET_URL'] = f's3://{WAREHOUSE}'
    os.environ['DESTINATION__FILESYSTEM__CREDENTIALS__AWS_ACCESS_KEY_ID'] = S3_ACCESS_KEY
    os.environ['DESTINATION__FILESYSTEM__CREDENTIALS__AWS_SECRET_ACCESS_KEY'] = S3_SECRET_KEY
    os.environ['DESTINATION__FILESYSTEM__CREDENTIALS__ENDPOINT_URL'] = S3_ENDPOINT
    os.environ['DESTINATION__FILESYSTEM__CREDENTIALS__REGION'] = 'us-east-1'
    os.environ['DESTINATION__FILESYSTEM__CREDENTIALS__AWS_ALLOW_HTTP'] = 'true'

    try:
        for table_name in tables:
            logger.info(f"\n{'='*60}")
            logger.info(f"Processing: {table_name}")
            logger.info(f"{'='*60}")

            resource = create_table_resource(table_name, cdc, snapshot, MAX_EVENTS)
            
            pipeline = dlt.pipeline(
                pipeline_name='mysql_cdc',
                destination='filesystem',
                dataset_name=NAMESPACE,
            )

            info = pipeline.run(resource, table_name=table_name)
            logger.info(f"Complete: {table_name}")

        logger.info("\n" + "="*60)
        logger.info("SUCCESS - Data written to S3")
        logger.info(f"Location: s3://{WAREHOUSE}/{NAMESPACE}/")
        logger.info("="*60)
        return 0

    except Exception as e:
        logger.error(f"Failed: {e}", exc_info=True)
        return 1


if __name__ == '__main__':
    sys.exit(main())
