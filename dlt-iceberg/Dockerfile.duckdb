FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    curl \
    docker.io \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-duckdb.txt .
RUN pip install --no-cache-dir -r requirements-duckdb.txt

COPY duckdb-ui/ /app/duckdb-ui/

WORKDIR /app/duckdb-ui

EXPOSE 8501

CMD ["streamlit", "run", "streamlit_ui.py", "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true"]
