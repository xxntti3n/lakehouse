{
  "name": "starrocks",
  "displayName": "StarRocks",
  "implClass": "org.apache.ranger.services.starrocks.RangerServiceStarRocks",
  "properties": [
    {
      "name": "ranger.plugin.starrocks.service.name",
      "label": "Service Name",
      "defaultValue": "starrocksDev",
      "description": "Name of the StarRocks service"
    },
    {
      "name": "ranger.plugin.starrocks.fe.url",
      "label": "StarRocks FE URL",
      "defaultValue": "starrocks-fe:9030",
      "description": "StarRocks Frontend URL"
    },
    {
      "name": "username",
      "label": "Username",
      "defaultValue": "root",
      "description": "StarRocks admin username"
    },
    {
      "name": "password",
      "label": "Password",
      "defaultValue": "",
      "description": "StarRocks admin password",
      "isPassword": true
    }
  ]
}
